#!/bin/bash
# ION interop test wrapper script
#
# This script starts ION with STCP convergence layer for interoperability
# testing with Hardy.
#
# Environment variables:
#   ION_NODE_NUM  - Node number for IPN EID (default: 2)
#   STCP_PORT     - STCP listening port (default: 4557, avoids 4556 which is TCPCLv4)
#   REMOTE_HOST   - Hostname/IP of remote DTN node (optional)
#   REMOTE_PORT   - Remote STCP port (default: 4557)
#   REMOTE_NODE   - Remote node number (default: 1)

set -e

if [ "$1" = "tcpdump" ]; then
    exec "$@"
fi

CLA_TYPE=${CLA_TYPE:-stcp}
ION_NODE_NUM=${ION_NODE_NUM:-2}
STCP_PORT=${STCP_PORT:-4557}
LTP_PORT=${LTP_PORT:-1113}
REMOTE_HOST=${REMOTE_HOST:-}
REMOTE_PORT=${REMOTE_PORT:-4557}
REMOTE_NODE=${REMOTE_NODE:-1}
LTP_ENGINE_NUM=${LTP_ENGINE_NUM:-$ION_NODE_NUM}
REMOTE_LTP_ENGINE=${REMOTE_LTP_ENGINE:-$REMOTE_NODE}

echo "ION Interop Testing"
echo "  CLA:         $CLA_TYPE"
echo "  Node:        ipn:$ION_NODE_NUM.0"
if [ "$CLA_TYPE" = "ltp" ]; then
    echo "  LTP Engine:  $LTP_ENGINE_NUM (UDP port $LTP_PORT)"
    if [ -n "$REMOTE_HOST" ]; then
        echo "  Remote LTP:  $REMOTE_HOST:$REMOTE_PORT (engine $REMOTE_LTP_ENGINE, node ipn:$REMOTE_NODE.0)"
    fi
else
    echo "  STCP:        port $STCP_PORT"
    if [ -n "$REMOTE_HOST" ]; then
        echo "  Remote STCP: $REMOTE_HOST:$REMOTE_PORT (ipn:$REMOTE_NODE.0)"
    fi
fi
echo ""

# Report SysV shared memory limits (ION uses shmget)
echo "SysV IPC limits:"
echo "  shmmax: $(cat /proc/sys/kernel/shmmax 2>/dev/null || echo 'N/A')"
echo "  shmall: $(cat /proc/sys/kernel/shmall 2>/dev/null || echo 'N/A')"
echo "  shmmni: $(cat /proc/sys/kernel/shmmni 2>/dev/null || echo 'N/A')"
echo ""

# ION requires wmKey and sdrName to match compiled-in defaults on first
# initialization (wmKey=65281, sdrName="ion"). Each container runs a single
# ION instance so there's no collision risk.

cat > /ion/ion.ionconfig << EOF
wmKey 65281
sdrName ion
wmSize 5000000
configFlags 1
heapWords 5000000
EOF

cat > /ion/ion.ionrc << EOF
1 ${ION_NODE_NUM} ion.ionconfig
s
m horizon +0
a range +0 +86400 ${ION_NODE_NUM} ${ION_NODE_NUM} 0
EOF

# Add contact/range to remote node if configured
if [ -n "$REMOTE_HOST" ]; then
    cat >> /ion/ion.ionrc << EOF
a range +0 +86400 ${ION_NODE_NUM} ${REMOTE_NODE} 1
a range +0 +86400 ${REMOTE_NODE} ${ION_NODE_NUM} 1
a contact +0 +86400 ${ION_NODE_NUM} ${REMOTE_NODE} 100000
a contact +0 +86400 ${REMOTE_NODE} ${ION_NODE_NUM} 100000
EOF
fi

cat > /ion/ion.ionsecrc << EOF
1
EOF

if [ "$CLA_TYPE" = "ltp" ]; then
    # Build ltprc for LTP over UDP
    cat > /ion/ion.ltprc << EOF
1 100
EOF
    if [ -n "$REMOTE_HOST" ]; then
        cat >> /ion/ion.ltprc << EOF
a span ${REMOTE_LTP_ENGINE} 100 100 1400 1 1 'udplso ${REMOTE_HOST}:${REMOTE_PORT} ${REMOTE_LTP_ENGINE}' 1
EOF
    fi
    cat >> /ion/ion.ltprc << EOF
s 'udplsi 0.0.0.0:${LTP_PORT}'
EOF

    # Build bprc with LTP protocol
    cat > /ion/ion.bprc << EOF
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:${ION_NODE_NUM}.0 x
a endpoint ipn:${ION_NODE_NUM}.1 x
a endpoint ipn:${ION_NODE_NUM}.7 x
a protocol ltp 1400 100 -1
a induct ltp ${LTP_ENGINE_NUM} 'ltpcli ${LTP_ENGINE_NUM}'
EOF

    if [ -n "$REMOTE_HOST" ]; then
        cat >> /ion/ion.bprc << EOF
a outduct ltp ${REMOTE_LTP_ENGINE} 'ltpclo ${REMOTE_LTP_ENGINE}'
EOF
    fi

    cat >> /ion/ion.bprc << EOF
r 'ipnadmin ion.ipnrc'
s
EOF

    # Build ipnrc with route to remote node via LTP
    cat > /ion/ion.ipnrc << EOF
EOF
    if [ -n "$REMOTE_HOST" ]; then
        cat >> /ion/ion.ipnrc << EOF
a plan ${REMOTE_NODE} ltp/${REMOTE_LTP_ENGINE}
EOF
    fi

else
    # Build bprc with STCP protocol
    cat > /ion/ion.bprc << EOF
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:${ION_NODE_NUM}.0 x
a endpoint ipn:${ION_NODE_NUM}.1 x
a endpoint ipn:${ION_NODE_NUM}.7 x
a protocol stcp 1400 100 -1
a induct stcp 0.0.0.0:${STCP_PORT} stcpcli
EOF

    if [ -n "$REMOTE_HOST" ]; then
        cat >> /ion/ion.bprc << EOF
a outduct stcp ${REMOTE_HOST}:${REMOTE_PORT} stcpclo
EOF
    fi

    cat >> /ion/ion.bprc << EOF
r 'ipnadmin ion.ipnrc'
s
EOF

    cat > /ion/ion.ipnrc << EOF
EOF
    if [ -n "$REMOTE_HOST" ]; then
        cat >> /ion/ion.ipnrc << EOF
a plan ${REMOTE_NODE} stcp/${REMOTE_HOST}:${REMOTE_PORT}
EOF
    fi
fi

echo "Starting ION..."

# Clean up any stale ION shared memory/semaphores from previous runs.
echo "Cleaning stale ION IPC state..."
killm 2>/dev/null || true
sleep 1

# Initialize and start ION
cd /ion
ionadmin ion.ionrc
ionsecadmin ion.ionsecrc
if [ "$CLA_TYPE" = "ltp" ]; then
    echo "Configuring LTP in ION..."
    ltpadmin ion.ltprc
fi
bpadmin ion.bprc

echo "ION started successfully"
echo "  Local EID:   ipn:${ION_NODE_NUM}.0"
if [ "$CLA_TYPE" = "ltp" ]; then
    echo "  LTP port:    ${LTP_PORT}"
else
    echo "  STCP port:   ${STCP_PORT}"
fi

# Keep container running
trap 'echo "Shutting down ION..."; bpadmin . 2>/dev/null; if [ "$CLA_TYPE" = "ltp" ]; then ltpadmin . 2>/dev/null; fi; ionadmin . 2>/dev/null; killm 2>/dev/null; exit 0' SIGTERM SIGINT

while true; do
    sleep 3600 &
    wait $!
done
